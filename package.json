{
  "name": "automator",
  "version": "3.0.0",
  "description": "White Dreams™ | Automator — A calmer way to download",
  "author": "SHAN",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "main.js",
  "engines": {"node": "^22.22.2 || ^24.15.0 || >=26.0.0"},
  "scripts": {
    "start": "electron .",
    "serve": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui-smoke.js",
    "test:dom": "node tests/dom-smoke.js",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win --publish never",
    "pack": "electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "cloakbrowser": "0.5.10",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.0"
  },
  "build": {
    "appId": "com.whitedreams.automation",
    "productName": "Automator",
    "copyright": "© SHAN",
    "publish": {
      "provider": "github",
      "owner": "s-shavishan",
      "repo": "White-Dreams-Automator"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "bypass.js",
      "dl_gen.js",
      "env.js",
      "core/**/*.js",
      "build/icon.ico",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/cloakbrowser/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/playwright/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Automator-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Automator",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
